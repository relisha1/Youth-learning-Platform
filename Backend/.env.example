PORT=5000
NODE_ENV=development
JWT_SECRET=put_a_long_random_text_here

# optional: creates the first admin when there are no users yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# optional: SMS with Africa's Talking (https://africastalking.com).
# Use AT_USERNAME=sandbox and a sandbox key to test.
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=

# optional: email with Resend (https://resend.com)
# RESEND_API_KEY=
# EMAIL_FROM=Youth Tech Hub <you@your-domain.com>

# optional: where the database file is kept
# DB_PATH=./data/youth-hub.db
